# Supabase: use local values from `npx supabase status` for development.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only. Required for account deletion and privileged billing/usage writes.
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only provider credentials. Configure only the features you will exercise.
OPENAI_API_KEY=""
BRAINTRUST_API_KEY=""
WHOXY_API_KEY=""
RAPID_API_KEY=""

# Markprompt support chat (email support is available without chat).
# Public project key. Omit optional endpoint overrides to use SDK defaults.
NEXT_PUBLIC_PROJECT_KEY=""
# NEXT_PUBLIC_API_URL="https://api.markprompt.com"

# Stripe: use test mode locally. Never mix test and live IDs/keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_ENDPOINT_SECRET=""
# Server-owned checkout/entitlements: recurring Stripe price IDs.
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
# Legacy UI mappings use Stripe product IDs, not price IDs.
FREE_PLAN_ID_TEST=""
PRO_PLAN_ID_TEST=""
BUSINESS_PLAN_ID_TEST=""
FREE_PLAN_ID_PRODUCTION=""
PRO_PLAN_ID_PRODUCTION=""
BUSINESS_PLAN_ID_PRODUCTION=""
